    "lines": [
      {
        "line": 9,
        "text": "# G2 is staging-only: production is frozen for every action, so it intentionally"
      },
      {
        "line": 12,
        "text": "ALLOWED_ACTIONS = {"
      },
      {
        "line": 13,
        "text": "    \"staging\": frozenset({\"plan\", \"rollback\"}),"
      },
      {
        "line": 14,
        "text": "    \"production\": frozenset(),"
      },
      {
        "line": 15,
        "text": "}"
      },
      {
        "line": 20,
        "text": "FROZEN_ENVIRONMENTS = frozenset({\"production\"})"
      },
      {
        "line": 43,
        "text": "    if not isinstance(environment, str) or environment not in ALLOWED_ACTIONS:"
      },
      {
        "line": 44,
        "text": "        raise PolicyError(\"invalid-environment\")"
      },
      {
        "line": 45,
        "text": "    if environment in FROZEN_ENVIRONMENTS:"
      },
      {
        "line": 46,
        "text": "        raise PolicyError(\"production-frozen\")"
      },
      {
        "line": 59,
        "text": "    environment = check_environment(request)"
      },
      {
        "line": 62,
        "text": "    # Same unhashable guard as above for non-string actions."
      },
      {
        "line": 64,
        "text": "    if not isinstance(action, str) or action not in ALLOWED_ACTIONS[environment]:"
      },
      {
        "line": 65,
        "text": "        raise PolicyError(\"unsupported-action\")"
      }
    ]
  },
