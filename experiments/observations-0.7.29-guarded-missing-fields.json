      "sha256": "7cfadf3cc1c81295d9fee5e260e9744d92c6889f6349368c7d63064f587585a7",
      "lines": [
        {
          "line": 8,
          "text": "def main():"
        },
        {
          "line": 9,
          "text": "    try:"
        },
        {
          "line": 10,
          "text": "        request = json.load(sys.stdin)"
        },
        {
          "line": 11,
          "text": "    except (ValueError, TypeError):"
        },
        {
          "line": 12,
          "text": "        result = {\"status\": \"error\", \"error\": \"invalid-json\", \"actions\": [], \"units\": 0}"
        },
        {
          "line": 13,
          "text": "    else:"
        },
        {
          "line": 14,
          "text": "        result = plan(request)"
        },
        {
          "line": 15,
          "text": "    print(json.dumps(result, separators=(\",\", \":\")))"
        }
      ]
