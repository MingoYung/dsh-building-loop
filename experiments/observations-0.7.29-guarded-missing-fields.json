    {
      "file": "planner.py",
      "sha256": "6e0856d53ed6ff15699757659cc31a0f7882f7ce09f0e5b999ff7143170d7b23",
      "lines": [
        {
          "line": 29,
          "text": "def handle(request):"
        },
        {
          "line": 31,
          "text": "    if not isinstance(request, dict):"
        },
        {
          "line": 32,
          "text": "        # Protected interface: a non-object request stays invalid-request and"
        },
        {
          "line": 34,
          "text": "        return failure(\"invalid-request\")"
        },
        {
          "line": 35,
          "text": "    try:"
        },
        {
          "line": 38,
          "text": "        # any graph error and stay stable regardless of ``changes`` content."
        },
        {
          "line": 39,
          "text": "        budget = limit_for(request)"
        },
        {
          "line": 40,
          "text": "        action = request.get(\"action\")"
        },
        {
          "line": 41,
          "text": "        unique = canonical(read_changes(request.get(\"changes\")))"
        }
      ]
    },
    {
      "file": "policy.py",
      "sha256": "d74935b98c920915efb4b8259f11e12cbc8647e9e611314ac098f966bd356ea7",
      "lines": [
        {
          "line": 18,
          "text": "def limit_for(request):"
        },
        {
          "line": 19,
          "text": "    \"\"\"Return the validated budget; raise PolicyError for an unusable request.\"\"\""
        },
        {
          "line": 20,
          "text": "    if not isinstance(request.get(\"environment\"), str) or request.get(\"environment\") not in ENVIRONMENTS:"
        },
        {
          "line": 21,
          "text": "        raise PolicyError(\"invalid-environment\")"
        },
        {
          "line": 22,
          "text": "    if not isinstance(request.get(\"action\"), str) or request.get(\"action\") not in SUPPORTED_ACTIONS:"
        },
        {
          "line": 24,
          "text": "        # (including a missing action) is refused before any graph work. The"
        },
        {
          "line": 26,
          "text": "        # (unhashable) and would escape as a crash instead of an error result."
        },
        {
          "line": 27,
          "text": "        raise PolicyError(\"unsupported-action\")"
        },
        {
          "line": 28,
          "text": "    budget = request.get(\"budget\")"
        },
        {
          "line": 30,
          "text": "    # booleans from every integer field."
        },
        {
          "line": 31,
          "text": "    if type(budget) is not int or budget < 0:"
        },
        {
          "line": 32,
          "text": "        raise PolicyError(\"invalid-budget\")"
        }
      ]
    },
    {
      "file": "journal.py",
      "sha256": "ed972701aa8196f4c354a02ffbd19b5d6063e73a3ada7c05377cbb8006e7a32b",
      "lines": [
        {
          "line": 39,
          "text": "def read_changes(records):"
        },
        {
          "line": 40,
          "text": "    if not isinstance(records, list):"
        },
        {
          "line": 41,
          "text": "        raise JournalError(\"invalid-change\")"
        },
        {
          "line": 42,
          "text": "    changes = []"
        },
        {
          "line": 43,
          "text": "    for row in records:"
        },
        {
          "line": 44,
          "text": "        if (not isinstance(row, dict) or not isinstance(row.get(\"id\"), str) or not row[\"id\"]"
        },
        {
          "line": 45,
          "text": "                or not isinstance(row.get(\"component\"), str) or not row[\"component\"]"
        }
      ]
    }
